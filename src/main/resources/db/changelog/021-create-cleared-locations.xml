<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="022-create-cleared-locations" author="Sawaron">
        <createTable tableName="player_cleared_locations">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="player_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_cleared_player" referencedTableName="players" referencedColumnNames="id"/>
            </column>
            <column name="location_id" type="VARCHAR(100)">
                <constraints nullable="false" foreignKeyName="fk_cleared_location" referencedTableName="locations" referencedColumnNames="id"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="player_cleared_locations"
                             columnNames="player_id, location_id"
                             constraintName="uq_player_cleared_location"/>
    </changeSet>

</databaseChangeLog>