<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="019-populate-test-loot" author="Sawaron">
        <insert tableName="monster_loot_tables">
            <column name="monster_template_id" valueComputed="(SELECT id FROM monster_templates WHERE name = 'Гоблин')"/>
            <column name="item_template_id" valueComputed="(SELECT id FROM item_templates WHERE name = 'Кровоцвет')"/>
            <column name="min_amount" valueNumeric="1"/>
            <column name="max_amount" valueNumeric="3"/>
            <column name="drop_chance" valueNumeric="50"/>
        </insert>
        <insert tableName="monster_loot_tables">
            <column name="monster_template_id" valueComputed="(SELECT id FROM monster_templates WHERE name = 'Скелет-воин')"/>
            <column name="item_template_id" valueComputed="(SELECT id FROM item_templates WHERE name = 'Железо')"/>
            <column name="min_amount" valueNumeric="1"/>
            <column name="max_amount" valueNumeric="1"/>
            <column name="drop_chance" valueNumeric="30"/>
        </insert>
        <insert tableName="monster_loot_tables">
            <column name="monster_template_id" valueComputed="(SELECT id FROM monster_templates WHERE name = 'Волк')"/>
            <column name="item_template_id" valueComputed="(SELECT id FROM item_templates WHERE name = 'Кожа')"/>
            <column name="min_amount" valueNumeric="1"/>
            <column name="max_amount" valueNumeric="3"/>
            <column name="drop_chance" valueNumeric="70"/>
        </insert>
    </changeSet>

</databaseChangeLog>
