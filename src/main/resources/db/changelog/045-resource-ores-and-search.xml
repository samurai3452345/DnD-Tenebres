    <changeSet id="045-ores-and-ingots" author="codex">
        <!-- Preserve IDs and existing inventories / loot references. -->
        <sql>
            UPDATE item_templates SET name = 'Железный слиток' WHERE name = 'Железо';
            UPDATE item_templates SET name = 'Мифриловый слиток' WHERE name = 'Мифрил';
            UPDATE item_templates SET name = 'Орихалковый слиток' WHERE name = 'Орихалк';

            UPDATE location_loot_tables SET item_template_id = (SELECT id FROM item_templates WHERE name = 'Железная руда')
             WHERE item_template_id = (SELECT id FROM item_templates WHERE name = 'Железный слиток');
            UPDATE location_loot_tables SET item_template_id = (SELECT id FROM item_templates WHERE name = 'Мифриловая руда')
             WHERE item_template_id = (SELECT id FROM item_templates WHERE name = 'Мифриловый слиток');
            UPDATE location_loot_tables SET item_template_id = (SELECT id FROM item_templates WHERE name = 'Орихалковая руда')
             WHERE item_template_id = (SELECT id FROM item_templates WHERE name = 'Орихалковый слиток');
            UPDATE locations SET search_difficulty = 6 WHERE id IN ('forest_edge', 'forest_wolf_trail', 'forest_goblin_camp');
        </sql>
    </changeSet>
