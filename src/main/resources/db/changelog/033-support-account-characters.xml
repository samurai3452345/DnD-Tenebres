<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="033-support-account-characters" author="codex">
        <addColumn tableName="players">
            <column name="account_id" type="BIGINT"/>
        </addColumn>

        <sql>
            UPDATE players
            SET account_id = (
                SELECT MIN(user_accounts.id)
                FROM user_accounts
                WHERE user_accounts.player_id = players.id
            )
            WHERE EXISTS (
                SELECT 1
                FROM user_accounts
                WHERE user_accounts.player_id = players.id
            )
        </sql>

        <addForeignKeyConstraint
                baseTableName="players"
                baseColumnNames="account_id"
                constraintName="fk_player_account"
                referencedTableName="user_accounts"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createIndex tableName="players" indexName="idx_players_account">
            <column name="account_id"/>
        </createIndex>

        <dropForeignKeyConstraint
                baseTableName="user_accounts"
                constraintName="fk_user_player"/>
        <dropColumn tableName="user_accounts" columnName="player_id"/>
    </changeSet>
</databaseChangeLog>
