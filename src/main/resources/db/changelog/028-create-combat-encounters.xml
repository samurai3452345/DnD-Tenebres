<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
 <changeSet id="028-create-combat-encounters" author="codex">
  <createTable tableName="combat_encounters">
   <column name="id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
   <column name="version" type="INTEGER" defaultValueNumeric="0"><constraints nullable="false"/></column>
   <column name="player_id" type="BIGINT"><constraints nullable="false" referencedTableName="players" referencedColumnNames="id" foreignKeyName="fk_encounter_player"/></column>
   <column name="status" type="VARCHAR(30)"><constraints nullable="false"/></column>
   <column name="reason" type="VARCHAR(30)"><constraints nullable="false"/></column>
   <column name="round" type="INTEGER"><constraints nullable="false"/></column>
   <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
  </createTable>
  <createTable tableName="combat_participants">
   <column name="id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
   <column name="encounter_id" type="BIGINT"><constraints nullable="false" referencedTableName="combat_encounters" referencedColumnNames="id" foreignKeyName="fk_participant_encounter"/></column>
   <column name="monster_id" type="BIGINT"><constraints nullable="false" referencedTableName="monsters" referencedColumnNames="id" foreignKeyName="fk_participant_monster"/></column>
   <column name="turn_order" type="INTEGER"><constraints nullable="false"/></column>
   <column name="status" type="VARCHAR(30)"><constraints nullable="false"/></column>
  </createTable>
  <addUniqueConstraint tableName="combat_participants" columnNames="encounter_id,monster_id" constraintName="uq_encounter_monster"/>
  <createTable tableName="monster_combat_effects">
   <column name="monster_id" type="BIGINT"><constraints nullable="false" referencedTableName="monsters" referencedColumnNames="id" foreignKeyName="fk_effect_monster"/></column>
   <column name="effect_type" type="VARCHAR(50)"><constraints nullable="false"/></column>
   <column name="duration" type="INTEGER"><constraints nullable="false"/></column>
   <column name="power" type="INTEGER"><constraints nullable="false"/></column>
  </createTable>
 </changeSet>
</databaseChangeLog>
