<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    
    <changeSet id="create-quests" author="Sawaron">
        <createTable tableName="quest_templates">
            <column name="id"  type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="quest_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="target_identifier" type="VARCHAR(255)">
                <constraints nullable = "false"/>
            </column>
            <column name="target_count" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="reward_xp" type="INTEGER">
                <constraints nullable = "false"/>
            </column>
            <column name="reward_gold" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="player_quests" author="Sawaron">
        <createTable tableName="player_quests">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="player_id" type="BIGINT">
                <constraints foreignKeyName="fk_player_quests_player" references="players.id" nullable="false"/>
            </column>
            <column name="quest_template_id" type="BIGINT">
                <constraints foreignKeyName="fk_player_quests_template" references="quest_templates.id" nullable="false"/>
            </column>
            <column name="current_progress" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>