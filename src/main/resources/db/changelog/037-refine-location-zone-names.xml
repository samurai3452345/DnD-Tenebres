<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="037-refine-location-zone-names" author="codex">
        <update tableName="locations">
            <column name="zone_name" value="Талмирия"/>
            <where>zone_id = 'talmiria'</where>
        </update>
        <update tableName="locations">
            <column name="zone_name" value="Зеленый лес"/>
            <where>zone_id = 'green_forest'</where>
        </update>
        <update tableName="locations">
            <column name="zone_name" value="Заброшенный склеп"/>
            <where>zone_id = 'forgotten_crypt'</where>
        </update>
    </changeSet>
</databaseChangeLog>
