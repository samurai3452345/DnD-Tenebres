<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="035-main-game-screen-data" author="codex">
        <addColumn tableName="quest_templates">
            <column name="quest_source" type="VARCHAR(30)" defaultValue="GUILD">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addColumn tableName="locations">
            <column name="boss_room" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <update tableName="locations">
            <column name="boss_room" valueBoolean="true"/>
            <where>id = 'crypt_boss_room'</where>
        </update>
    </changeSet>
</databaseChangeLog>
