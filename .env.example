# Обязательные секреты. Не храните реальные значения в Git.
DB_PASSWORD=
JWT_SECRET=
SPRING_PROFILES_ACTIVE=local

# Необязательные настройки локального окружения.
DB_URL=jdbc:postgresql://localhost:5432/dnd_tenebres
DB_USERNAME=postgres
JWT_EXPIRATION=PT24H
JWT_ISSUER=dnd-tenebres
JWT_AUDIENCE=dnd-tenebres-api
# Заполняйте предыдущим секретом только на период ротации ключа (не дольше TTL токена).
JWT_PREVIOUS_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_TRUSTED_PROXY=false
